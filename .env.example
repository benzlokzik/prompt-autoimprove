PAI_ENVIRONMENT=dev
PAI_LOG_LEVEL=INFO

PAI_DB__DSN=postgresql+asyncpg://pai:pai@localhost:5432/pai
PAI_KAFKA__BOOTSTRAP_SERVERS=localhost:19092
PAI_KAFKA__ENABLED=false

# Required outside dev (PAI_ENVIRONMENT != dev). In dev it defaults to "dev-key".
PAI_API__API_KEY=dev-key
# Set to 1 to permit the built-in dev key outside dev (local use only).
PAI_API__ALLOW_DEV_KEY=0
PAI_API__RATE_LIMIT_PER_MINUTE=60
PAI_API__HTTP_PORT=8000
PAI_API__GRPC_PORT=50051
# Comma-separated list of allowed CORS origins for the HTTP API.
PAI_API__CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
